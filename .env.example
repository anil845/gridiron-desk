# Copy to .env and fill in. .env is gitignored.

# Postgres connection. Either set DATABASE_URL, or leave it blank and use the
# standard libpq PG* variables below.
DATABASE_URL=postgresql://gridiron:CHANGE_ME@localhost:5432/gridiron
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=gridiron
# PGUSER=gridiron
# PGPASSWORD=CHANGE_ME

# Where cached source payloads are written (gitignored). Defaults to ./data
DATA_DIR=./data

# --- Not yet used ----------------------------------------------------------
# FantasyPros API key. Access requested; ingestion not built yet.
# FANTASYPROS_API_KEY=

# Yahoo Fantasy OAuth. Access pending approval; no integration exists yet.
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
